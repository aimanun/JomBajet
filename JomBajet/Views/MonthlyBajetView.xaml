<UserControl x:Class="JomBajet.Views.MonthlyBajetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Label Content="Net Salary :" FontSize="16"/>
            <Label Content="RM" FontSize="16" FontWeight="DemiBold"/>
            <TextBox Text="{Binding NetSalary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="30" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Label Content="Split Rule :" FontSize="16" VerticalAlignment="Center"/>
            <Button Content="50 / 30 / 20" Command="{Binding FiftyCommand}" FontSize="16" Style="{StaticResource RoundedButton}"/>
            <Button Content="70 / 20 / 10" Command="{Binding SeventyCommand}" FontSize="16" Style="{StaticResource RoundedButton}"/>
            
            <CheckBox Content="Customise" IsChecked="{Binding EnableCustomise}" VerticalAlignment="Center" Margin="10"/>
            <TextBox Grid.Column="0" Text="{Binding CommitmentSplit}" IsEnabled="{Binding EnableCustomise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="30" FontSize="16" Margin="5"/>
            <TextBlock Text="%" VerticalAlignment="Center" FontSize="16" FontWeight="DemiBold" Margin="0 0 5 0"/>
            <TextBox Grid.Column="1" Text="{Binding SpendingSplit}" IsEnabled="{Binding EnableCustomise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="30" FontSize="16" Margin="5"/>
            <TextBlock Text="%" VerticalAlignment="Center" FontSize="16" FontWeight="DemiBold" Margin="0 0 5 0"/>
            <TextBox Grid.Column="2" Text="{Binding SavingSplit}" IsEnabled="{Binding EnableCustomise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="45" Height="30" FontSize="16" Margin="5"/>
            <TextBlock Text="%" VerticalAlignment="Center" FontSize="16" FontWeight="DemiBold" Margin="0 0 5 0"/>
            <Button Content="Confirm" Command="{Binding ConfirmCommand}" IsEnabled="{Binding EnableCustomise}" FontSize="16" Style="{StaticResource WindowsButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" Background="SandyBrown">
            <TextBlock Text="Commitment" FontWeight="DemiBold" FontSize="24" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Bajet Amount: RM" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5 5 0 5"/>
                <Label Content="{Binding Commitment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Margin="0 5 5 5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Background="AliceBlue">
            <TextBlock Text="Spending" FontWeight="DemiBold" FontSize="24" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Bajet Amount: RM" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5 5 0 5"/>
                <Label Content="{Binding Spending, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Margin="0 5 5 5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Background="YellowGreen">
            <TextBlock Text="Saving" FontWeight="DemiBold" FontSize="24" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Bajet Amount: RM" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5 5 0 5"/>
                <Label Content="{Binding Saving, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Margin="0 5 5 5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
